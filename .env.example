APP_ENV=development
LOG_LEVEL=INFO
AGENT_PROVIDER=mock
# Week 2 bounded mock-tool execution policy (validated: attempts 1..5, timeout 0 < t <= 5.0).
TOOL_MAX_ATTEMPTS=2
TOOL_TIMEOUT_SECONDS=0.25
# Demo actor label for the local stdio MCP server logs. Not authentication.
MCP_DEMO_ACTOR_ID=tenant-a-operator
# Week 3 local RAG lab. Server-owned and validated at startup; none of these are secrets.
RAG_CORPUS_PATH=data/rag/synthetic_documents.v1.json
# Chunk size 16..512 whitespace tokens; overlap 0..256 and smaller than the chunk size.
RAG_CHUNK_SIZE_TOKENS=80
RAG_CHUNK_OVERLAP_TOKENS=20
# Hashed lexical embedding buckets, 32..1024.
RAG_EMBEDDING_DIMENSIONS=128
# none | lexical. Clients cannot choose the reranker.
RAG_RERANKER=lexical
# Upper bound for the request's top_k, 1..5.
RAG_MAX_TOP_K=5
# Evidence gate: minimum cosine score (0..1) and minimum share of question terms (0 < x <= 1).
RAG_MIN_EVIDENCE_SCORE=0.15
RAG_MIN_QUERY_TERM_COVERAGE=0.7
